<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Configuración para desarrollo: permite HTTP a localhost/emulador -->
    <domain-config cleartextTrafficPermitted="true">
        <!-- Emulador Android (10.0.2.2 es el localhost del host) -->
        <domain includeSubdomains="true">10.0.2.2</domain>
        <!-- Localhost -->
        <domain includeSubdomains="true">localhost</domain>
        <!-- IP local para dispositivos físicos (ajusta según tu red) -->
        <domain includeSubdomains="true">192.168.1.0</domain>
        <domain includeSubdomains="true">192.168.0.0</domain>
    </domain-config>

    <!-- Configuración base: HTTPS obligatorio para todo lo demás -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>

